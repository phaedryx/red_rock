# frozen_string_literal: true

require "test_helper"

# Run all the tests with:  bin/red_rock test
class <%= class_name %>Test < Minitest::Test
  def test_is_listed_in_the_mod
    assert_includes <%= module_name %>::Mod.contents, <%= module_name %>::<%= class_name %>
  end

  def test_has_a_texture_file
    assert File.file?(File.expand_path("../../textures/#{<%= module_name %>::<%= class_name %>.texture}", __dir__)),
           "put a 16x16 PNG at textures/#{<%= module_name %>::<%= class_name %>.texture}"
  end
end
